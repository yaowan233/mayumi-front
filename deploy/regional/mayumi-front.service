[Unit]
Description=Mayumi regional frontend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mayumi
Group=mayumi
WorkingDirectory=/opt/mayumi/web
Environment=NODE_ENV=production
Environment=BACKEND_INTERNAL_URL=http://127.0.0.1:18421
Environment=PATH=/opt/mayumi/node/bin:/usr/bin:/bin
Environment=NODE_OPTIONS=--max-old-space-size=160
Environment=MALLOC_ARENA_MAX=2
ExecStart=/opt/mayumi/node/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=3
MemoryAccounting=true
MemoryHigh=256M
MemoryMax=320M
MemorySwapMax=64M
CPUQuota=100%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mayumi/web/.next/cache

[Install]
WantedBy=multi-user.target
